<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # Serve existing files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map extensionless paths to corresponding .php file (supports nested paths)
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>
