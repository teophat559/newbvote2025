# Production Environment Configuration Template
# Copy this file to .env.production and customize for your production environment
# IMPORTANT: Generate secure keys before deployment!

# Application Environment
APP_ENV=production
APP_URL=https://newbvote2025s.online
APP_NAME="Special Program 2025"

# Database Configuration  
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=newbvote2025s_db
DB_USER=newbvote2025s_user
DB_PASS=your_secure_database_password_here

# WebSocket Configuration
WS_HOST=127.0.0.1
WS_PORT=8090

# Security Settings (GENERATE STRONG KEYS FOR PRODUCTION)
# Use: openssl rand -base64 32 to generate secure keys
ADMIN_SECURITY_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY-MINIMUM-20-CHARS
DATA_ENCRYPTION_KEY=CHANGE-THIS-TO-32-CHARACTER-KEY-abc123def456ghi789jkl
SESSION_SECURE_COOKIE=1
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900

# Error Reporting (Production Settings)
ERROR_DISPLAY=0
ERROR_LOG_PATH=/var/log/php_errors.log

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://newbvote2025s.online,https://www.newbvote2025s.online

# Email Configuration (if used)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Production Optimization
OPCACHE_ENABLED=1
CACHE_LIFETIME=3600